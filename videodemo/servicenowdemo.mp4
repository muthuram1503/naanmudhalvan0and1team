._apdl { align-items: center; background-color: var(--splashscreen-startup-=
background); display: flex; flex-direction: column; height: 100%; justify-c=
ontent: center; left: 0px; position: fixed; top: 0px; user-select: none; wi=
dth: 100%; font-family: "SF Pro Text", "SF Pro Icons", system, -apple-syste=
m, system-ui, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, =
Arial, "Lucida Grande", Ubuntu, Cantarell, "Fira Sans", sans-serif; }

._apdl ._apdm { margin-top: -40px; color: var(--splashscreen-startup-icon);=
 }

._apdl ._apdm::after { animation: 1.5s linear 0.6s infinite normal none run=
ning shimmer; background: linear-gradient(to right,rgba(var(--splashscreen-=
startup-background-rgb),.5) 0% 33.33%,rgba(var(--splashscreen-startup-backg=
round-rgb),0) 44.1% 55.8%,rgba(var(--splashscreen-startup-background-rgb),.=
5) 66.66% 100%); content: ""; position: relative; top: -100%; display: bloc=
k; height: 100%; left: calc(50% - 72px); opacity: 1; width: 216px; }

@keyframes shimmer {=20
  0% { left: calc(50% - 72px); }
  100% { left: calc(50% + 72px); }
}

._apdl ._apdq { height: 4px; margin-top: 28px; border-radius: 4px; position=
: relative; width: 200px; }

._apdl ._apdq progress { vertical-align: top; }

._apdl ._apdr { margin-top: 20px; font-size: 18px; color: var(--splashscree=
n-primary-title); }

._apdl ._apds { margin-top: 32px; font-size: 14px; color: var(--splashscree=
n-secondary-lighter); }

._apdl ._apds span { display: inline-block; margin-bottom: 2px; vertical-al=
ign: middle; }

._apdl ._apdq progress { appearance: none; background-color: var(--splashsc=
reen-progress-background); border: none; border-radius: 100px; color: var(-=
-splashscreen-progress-primary); height: 4px; margin: 0px; width: 100%; }

._apdl ._apdq progress[value]::-webkit-progress-bar { border-radius: 4px; b=
ackground-color: var(--splashscreen-progress-background); }

._apdl ._apdq progress[value]::-webkit-progress-value { background-color: v=
ar(--splashscreen-progress-primary); transition: width 0.45s; }
